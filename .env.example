# Server
NODE_ENV=development
PORT=4000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3737

# Database (Railway will inject this in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afrizonemart

# Auth
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Frontend (for redirects, magic links etc.)
WEB_URL=http://localhost:3737

# ── Email ───────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty to print emails to the console instead of
# delivering them. Setting it switches to real delivery, so read the
# allowlist note below before you do that locally.
#
# The sending domain must be verified in Resend (DKIM/SPF) or every
# send fails.
RESEND_API_KEY=
EMAIL_FROM=Afrizonemart Suppliers <suppliers@afrizonemart.com>
# Supplier onboarding is a business relationship — replies must reach a
# human, not a no-reply void.
EMAIL_REPLY_TO=suppliers@afrizonemart.com
# Optional: feeds opens/bounces back into /admin/notifications.
RESEND_WEBHOOK_SECRET=

# SAFETY NET — outside production, only these addresses get real email;
# everything else is routed to the console. The dev database contains
# real supplier addresses, so an unguarded local trigger would email an
# actual business. Comma-separated; "*@domain.com" wildcards allowed.
# Empty means nothing is delivered (fail closed) — deliberate.
EMAIL_DEV_ALLOWLIST=

# Base URL for links INSIDE emails. Separate from WEB_URL on purpose: an
# email outlives the machine that sent it, so a localhost link would be
# dead on arrival in a supplier's inbox. Override only when you want to
# click through to your own dev server.
EMAIL_LINK_BASE=https://afrizonemart.com

# Supplier lifecycle reminder cron (PO unacknowledged / delivery due).
# Dry run by default: it logs who WOULD be emailed and sends nothing.
# Read those logs for a few days before setting this to 1.
SUPPLIER_LIFECYCLE_SEND=0

# ---------------------------------------------------------------------------
# Assessment report narrative drafting
# ---------------------------------------------------------------------------
# Drafts the ~1,000 authored words of a Conformity Diagnostic Report (executive
# summary, headline findings, final decision). Leave empty to disable: the
# report still generates in full and the auditor writes those passages by hand.
#
# Drafts are NEVER released unreviewed — a lead auditor must read and approve
# each passage before the report can be authorised.
ANTHROPIC_API_KEY=
ASSESSMENT_NARRATIVE_MODEL=claude-opus-5

# Who receives the QA copy of a released diagnostic report (comma-separated).
# Defaults to EMAIL_REPLY_TO when unset.
ASSESSMENT_REPORT_ADMIN_RECIPIENTS=
